  "lines": [
    {
      "id": "l1",
      "text": "ये रवि हैं। इनके पास मार्केट का सबसे अच्छा प्रोडक्ट है। लेकिन हर दिन, लोग उनकी दुकान के सामने से गुज़र जाते हैं।"
    },
    {
      "id": "l2",
      "text": "तो वो वही करते हैं, जो सब करते हैं। सबसे अच्छी क्वालिटी, सबसे कम दाम। तीन साल से।"
    },
    {
      "id": "l3",
      "text": "फिर एक सवाल ने उनका पूरा नज़रिया बदल दिया। ये प्रोडक्ट, कौन सी समस्या हल करता है?"
    },
    {
      "id": "l4",
      "text": "क्योंकि बेचना, प्रोडक्ट बताना नहीं है। बेचना, एक छह कदम की कहानी है।"
    },
    {
      "id": "l5",
      "text": "समस्या। तीव्रता। समाधान। सबूत। ऑफ़र। क्लोज़।"
    },
    {
      "id": "l6",
      "text": "समस्या, उनके शब्दों में बोलिए। बताइए, इंतज़ार की कीमत क्या है। फिर बताइए, आप क्या बेचते हैं।"
    },
    {
      "id": "l7",
      "text": "सबूत दीजिए। एक ग्राहक, एक आँकड़ा, एक पहले और बाद।"
    },
    {
      "id": "l8",
      "text": "एक साफ़ ऑफ़र। और एक साफ़ अगला कदम। दो नहीं।"
    },
    {
      "id": "l9",
      "text": "अगली सुबह, एक ग्राहक आई। मेरी माँ को नींद नहीं आती।"
    },
    {
      "id": "l10",
      "text": "रवि ने पिच नहीं किया। उन्होंने सुना। आपने अब तक क्या आज़माया?"
    },
    {
      "id": "l11",
      "text": "बहुत महंगा है। उन्होंने दाम नहीं बचाया। उन्होंने पूछा, किसके मुकाबले?"
    },
    {
      "id": "l12",
      "text": "रोज़ दो घंटे की नींद, पूरे एक साल। यही कीमत चुका रही हैं वो।"
    },
    {
      "id": "l13",
      "text": "छोटा पैक, आज रात के लिए? या फ़ैमिली पैक, महीने भर के लिए? उसने फ़ैमिली पैक लिया।"
    },
    {
      "id": "l14",
      "text": "नतीजा बेचिए, प्रोडक्ट नहीं। यही तरीका है, कुछ भी बेचने का।"
    }
  ],
